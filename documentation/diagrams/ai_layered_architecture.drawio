        <mxCell id="0fp3uru1z_SA0XE15nQW-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="AI layered architecture" vertex="1">
